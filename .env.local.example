# =============================================================================
# MasterFabric - Self-Hosted Environment Configuration
# =============================================================================
# Copy this file to .env.local and update with your values
# =============================================================================

# Application Version
VERSION=local

# Environment
NODE_ENV=development

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=masterfabric
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=./data/postgres

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis_cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=256mb
REDIS_DATA_PATH=./data/redis

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# =============================================================================
# Service API Keys (Service-to-Service Authentication)
# =============================================================================
CORE_SERVICE_API_KEY=core-service-api-key-change-me
PROVISIONING_SERVICE_API_KEY=provisioning-service-api-key-change-me
TENANT_RUNTIME_SERVICE_API_KEY=tenant-runtime-api-key-change-me

# =============================================================================
# Service URLs (Internal - Docker Network)
# =============================================================================
CORE_SERVICE_URL=http://core-service:3005/graphql
PROVISIONING_SERVICE_URL=http://provisioning-service:3003/graphql
TENANT_RUNTIME_URL=http://tenant-runtime:3004/graphql

# =============================================================================
# API Gateway Configuration
# =============================================================================
API_GATEWAY_PORT=3002
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
CACHE_TTL=300

# =============================================================================
# Dashboard Configuration (Public URLs)
# =============================================================================
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3002/graphql
NEXT_PUBLIC_CORE_SERVICE_URL=http://localhost:3005/graphql
NEXT_PUBLIC_TENANT_RUNTIME_URL=http://localhost:3004/graphql

# =============================================================================
# Service Ports
# =============================================================================
CORE_SERVICE_PORT=3005
PROVISIONING_SERVICE_PORT=3003
TENANT_RUNTIME_PORT=3004

# =============================================================================
# Cloudflare (Optional - for DNS management)
# =============================================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# =============================================================================
# Vault Configuration (Optional - for secrets management)
# =============================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=masterfabric-root-token
VAULT_ROOT_TOKEN=masterfabric-root-token
VAULT_PORT=8200
VAULT_DATA_PATH=./data/vault
VAULT_LOG_PATH=./logs/vault

# =============================================================================
# Development Tools Ports
# =============================================================================
PRISMA_STUDIO_PORT=5555
REDIS_COMMANDER_PORT=8081
