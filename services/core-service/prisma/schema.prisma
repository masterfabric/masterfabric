// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  PROVISIONING
  READY
  FAILED
}

enum UserRole {
  OWNER
  CUSTOMER
  DEVELOPER
}

model Organization {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  status            OrganizationStatus @default(PROVISIONING)
  postgresHost      String?
  postgresPort      Int?
  postgresDb        String?
  postgresUser      String?
  postgresPassword  String?
  postgresUpdatedAt DateTime?
  redisHost         String?
  redisPort         Int?
  redisPassword     String?
  redisUpdatedAt    DateTime?
  features          Json? // Feature flags: { allowDeveloperRole: true }
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  projects          Project[]
  systemSettings    SystemSettings?

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(CUSTOMER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      String? // ID of the user who invited this user (for DEVELOPER tracking)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("users")
}

model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantDbUri    String? // Stored after provisioning
  redisUri       String?

  // Tenant-level features (Supabase-like)
  authEnabled  Boolean @default(true)
  allowSignup  Boolean @default(true)
  jwtSecret    String? // Project-specific JWT secret
  jwtExpiresIn String  @default("7d")

  apiKeys     ApiKey[]
  tenantUsers TenantUser[]
  schemas     ProjectSchema[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("projects")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  key        String    @unique
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("api_keys")
}

model SchemaDefinition {
  id             String   @id @default(uuid())
  organizationId String
  tableName      String
  schemaJson     Json // Store the dynamic schema definition
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, tableName])
  @@map("schema_definitions")
}

// Tenant Users - End users of each project (like Supabase auth.users)
model TenantUser {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String? // Optional, for email/password auth
  provider     String  @default("email") // email, google, github, etc.
  providerId   String? // External provider ID

  metadata       Json? // Custom user data
  emailConfirmed Boolean   @default(false)
  lastSignInAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, email])
  @@index([projectId, provider])
  @@map("tenant_users")
}

// Project Schemas - Custom tables/collections for each project
model ProjectSchema {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tableName   String // Name of the custom table
  displayName String? // Human-readable name
  fields      Json // Field definitions: [{name, type, required, unique, default}, ...]

  // Permissions (Supabase-like RLS)
  enableRLS Boolean @default(false) // Row Level Security
  policies  Json? // [{name, operation, expression}, ...]

  // Real-time features
  enableRealtime Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, tableName])
  @@index([projectId])
  @@map("project_schemas")
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model SystemSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Microservice Settings
  apiGatewayUrl       String        @default("http://localhost:3002")
  apiGatewayStatus    ServiceStatus @default(ACTIVE)
  provisioningUrl     String        @default("http://localhost:3003")
  provisioningStatus  ServiceStatus @default(ACTIVE)
  tenantRuntimeUrl    String        @default("http://localhost:3004")
  tenantRuntimeStatus ServiceStatus @default(ACTIVE)

  // Data & Database Settings
  defaultDbHost    String @default("localhost")
  defaultDbPort    Int    @default(5432)
  defaultRedisHost String @default("localhost")
  defaultRedisPort Int    @default(6379)

  // Health Check Settings
  healthCheckInterval Int     @default(10) // in seconds
  healthCheckEnabled  Boolean @default(true)

  // Notifications
  notifyOnServiceDown Boolean @default(true)
  notifyOnHighLatency Boolean @default(true)
  latencyThresholdMs  Int     @default(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model SystemNotification {
  id             String   @id @default(uuid())
  organizationId String
  type           String // 'warning', 'error', 'info'
  title          String
  message        String
  isRead         Boolean  @default(false)
  metadata       Json? // Additional data
  createdAt      DateTime @default(now())

  @@index([organizationId, isRead])
  @@map("system_notifications")
}
